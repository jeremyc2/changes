{
	"name": "changes",
	"description": "Changesets CLI rewritten in Effect v4 and with no external dependencies.",
	"module": "index.ts",
	"type": "module",
	"bin": {
		"changes": "./index.ts"
	},
	"scripts": {
		"typecheck": "tsgo",
		"check": "bun --bun biome check --write",
		"test": "bun --bun vitest run",
		"test:watch": "bun --bun vitest",
		"references:update": "git submodule update --init --recursive",
		"prepare": "effect-tsgo patch",
		"chore:update": "bun update --latest && bun add effect@beta && bun add @effect/vitest@beta && bun add @effect/platform-bun@beta"
	},
	"dependencies": {
		"@effect/platform-bun": "^4.0.0-beta.70",
		"effect": "^4.0.0-beta.70"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@effect/tsgo": "^0.11.0",
		"@effect/vitest": "^4.0.0-beta.70",
		"@types/bun": "^1.3.14",
		"@typescript/native-preview": "^7.0.0-dev.20260525.1",
		"vitest": "^4.1.7"
	},
	"peerDependencies": {
		"typescript": "^6.0.3"
	}
}
